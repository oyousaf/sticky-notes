# Copy this file to .env and fill in real values. .env is gitignored.

# Client-side API base URL.
# In production the SPA calls the relative /api/notes Vercel proxy, so this
# can be left unset. Set it only if you're developing locally against a
# different backend or running without the proxy.
VITE_API_URL=

# Server-side: base URL the Vercel serverless functions proxy to.
# Set this on Vercel to point at your notes API host.
API_BASE_URL=